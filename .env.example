# Postgres connection string. On Vercel use the *pooled* URL from Neon (or similar).
DATABASE_URL=postgres://user:password@localhost:5432/sixtyone
# Random string; Vercel Cron sends it as "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=
# Optional: which count the scraper is storing. Set to "official" while the feed
# publishes the official result or recounts, then remove it
# (docs/official-results.md). Default: preliminary.
# COUNT_STAGE=official
# Optional: override the Electoral Commission feed location (e.g. a mirror).
FEED_BASE_URL=https://media.election.net.nz/xml
